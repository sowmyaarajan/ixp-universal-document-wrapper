<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <AssemblyName>IXPWrapper.Activities</AssemblyName>
    <RootNamespace>IXPWrapper.Activities</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Version>1.0.0</Version>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <!-- NuGet package metadata -->
    <PackageId>IXPWrapper.Activities</PackageId>
    <Title>IXP Universal Document Wrapper Activities</Title>
    <Authors>UiPath FDE Team</Authors>
    <Description>Process any document with UiPath IXP. Drag-and-drop activity returns extracted fields powered by Gemini. Requires LibreOffice on robot.</Description>
    <PackageTags>UiPath Activities IXP DocumentUnderstanding Extraction Gemini LibreOffice</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Activities from UiPath's cached packages (net5.0 compatible with net6.0) -->
    <Reference Include="System.Activities">
      <HintPath>$(USERPROFILE)\.nuget\packages\uipath.ocr.activities\3.6.2\build\net5.0\System.Activities.dll</HintPath>
    </Reference>
    <!-- JSON parsing -->
    <PackageReference Include="System.Text.Json" Version="6.0.10" />
  </ItemGroup>

</Project>
