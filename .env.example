# =============================================================
# IXP Universal Document Wrapper — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values.

# ── UiPath Cloud ─────────────────────────────────────────────
# Use https://staging.uipath.com for staging, https://cloud.uipath.com for prod
UIPATH_HOST=https://staging.uipath.com
UIPATH_ACCOUNT_NAME=your_org_name
UIPATH_TENANT_NAME=your_tenant_name

# ── OAuth Credentials ────────────────────────────────────────
# Create at: UiPath Cloud → Admin → External Applications → Add (Confidential)
# Required scopes: Du.Digitization.Api  Du.Extraction.Api
UIPATH_CLIENT_ID=your_client_id
UIPATH_CLIENT_SECRET=your_client_secret

# ── DU API Project Identifiers ───────────────────────────────
# Run this to discover your values:
#   GET {UIPATH_HOST}/{UIPATH_ACCOUNT_NAME}/{UIPATH_TENANT_NAME}/du_/api/framework/projects?api-version=1
#
# DU_ORG_UUID    = the org UUID in the returned detailsUrl
# DU_TENANT_UUID = the tenant UUID in the returned detailsUrl
# DU_PROJECT_ID  = id of your IXP project (type: IXP)
# DU_EXTRACTOR_ID= from project extractors, format: gpt_ixp_<version>
#                  Deploy your IXP project first (IXP UI → Deploy tab → Deploy button)
DU_ORG_UUID=your_org_uuid
DU_TENANT_UUID=your_tenant_uuid
DU_PROJECT_ID=your_ixp_project_id
DU_EXTRACTOR_ID=gpt_ixp_1

# ── Validation Thresholds ────────────────────────────────────
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=200

# ── Optional ─────────────────────────────────────────────────
# Override temp directory for PDF conversion (defaults to system temp)
TEMP_DIR=
